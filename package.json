{
  "name": "@zxiaosi/sdk",
  "version": "0.5.2",
  "description": "A micro frontend kit",
  "keywords": [
    "micro frontend",
    "qiankun",
    "vite"
  ],
  "license": "MIT",
  "author": "zxiaosi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxiaosi-team/fontend-sdk.git",
    "directory": "sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "axios": "^1.13.6"
  },
  "devDependencies": {
    "@tsdown/css": "^0.21.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "es-toolkit": "^1.45.1",
    "tsdown": "^0.21.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "qiankun": "^2.10.16",
    "react": "^18.3.1 || >=19.0.0",
    "react-dom": "^18.3.1 || >=19.0.0",
    "react-router-dom": "^6.30.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "react-router-dom": {
      "optional": false
    },
    "qiankun": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  }
